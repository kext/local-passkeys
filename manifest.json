{
  "manifest_version": 2,
  "name": "Local Passkeys",
  "version": "0.0.1",
  "description": "Create and use passkeys stored locally in Firefox, protected by a PIN or password. No account, server, or companion app required.",
  "developer": {
    "name": "kext",
    "url": "https://github.com/kext/local-passkeys"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "local-passkeys@kext.de",
      "strict_min_version": "149.0",
      "data_collection_permissions": {
        "required": ["authenticationInfo"]
      }
    }
  },
  "permissions": [
    "storage",
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "icons": {
    "32": "icons/key.svg",
    "64": "icons/key.svg",
    "128": "icons/key.svg"
  },
  "background": {
    "scripts": [
      "utils.js",
      "storage.js",
      "keys.js",
      "webauthn.js",
      "background.js",
      "management.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "Local Passkeys",
    "default_popup": "prompt.html",
    "default_icon": {
      "16": "icons/key.svg",
      "32": "icons/key.svg"
    }
  },
  "options_ui": {
    "page": "passkeys.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
