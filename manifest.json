{
  "manifest_version": 2,
  "name": "Local Passkeys",
  "version": "0.2.0",
  "description": "Local software passkeys with password-encrypted private keys. Experimental.",
  "browser_specific_settings": {
    "gecko": {
      "id": "local-passkeys-prototype@example.invalid",
      "strict_min_version": "149.0"
    }
  },
  "permissions": [
    "storage",
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "scripts": [
      "utils.js",
      "storage.js",
      "keys.js",
      "webauthn.js",
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "Local Passkeys",
    "default_popup": "prompt.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
